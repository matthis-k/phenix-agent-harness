#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if ! command -v devenv >/dev/null 2>&1; then
  echo "devenv is required to apply canonical repository fixes before commit" >&2
  exit 1
fi

mapfile -d '' staged_paths < <(git diff --cached --name-only --diff-filter=ACMR -z)

devenv tasks run maintenance:fix

# Re-stage only paths that were already part of this commit. The formatter may
# normalize other dirty working-tree files, but the hook must never capture
# unrelated user changes implicitly.
for path in "${staged_paths[@]}"; do
  if [[ -e "$path" || -L "$path" ]]; then
    git add -- "$path"
  fi
done

git diff --cached --check
