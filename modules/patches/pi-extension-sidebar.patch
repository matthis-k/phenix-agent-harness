+function fitLayoutLine(line: string, width: number): string {
+	const clipped = truncateToWidth(line, width, "");
+	return `${clipped}${" ".repeat(Math.max(0, width - visibleWidth(clipped)))}`;
+}
+
+class SidebarLayout implements Component {
+	constructor(
+		private readonly main: Component,
+		private readonly sidebar: Component,
+		private readonly viewportHeight: () => number,
+		private readonly requestedSidebarWidth: () => number | undefined,
+	) {}
+
+	invalidate(): void {
+		this.main.invalidate();
+		this.sidebar.invalidate();
+	}
+
+	render(width: number): string[] {
+		const requested = this.requestedSidebarWidth();
+		if (requested === undefined) return this.main.render(width);
+
+		const gap = 1;
+		const sidebarWidth = Math.min(Math.max(24, requested), Math.floor(width * 0.4));
+		const mainWidth = width - sidebarWidth - gap;
+		if (mainWidth < 56) return this.main.render(width);
+
+		const mainLines = this.main.render(mainWidth);
+		const sidebarLines = this.sidebar.render(sidebarWidth);
+		const total = Math.max(mainLines.length, sidebarLines.length);
+		const viewportStart = Math.max(0, total - Math.max(1, this.viewportHeight()));
+		return Array.from({ length: total }, (_, row) => {
+			const mainLine = fitLayoutLine(mainLines[row] ?? "", mainWidth);
+			const sidebarRow = row - viewportStart;
+			const sidebarLine =
+				sidebarRow >= 0 && sidebarRow < sidebarLines.length
+					? fitLayoutLine(sidebarLines[sidebarRow] ?? "", sidebarWidth)
+					: " ".repeat(sidebarWidth);
+			return `${mainLine}${" ".repeat(gap)}${sidebarLine}`;
+		});
+	}
+}
