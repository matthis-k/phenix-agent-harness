+/// Write the complete raw result for a Phenix-managed single command.
+/// This path is deliberately independent from RTK's user-facing tee policy:
+/// Phenix imports the file into its immutable memory store before deleting it.
+pub(crate) fn phenix_tee_raw(raw: &str) {
+    if std::env::var("PHENIX_RTK_LOSSLESS").ok().as_deref() != Some("1") {
+        return;
+    }
+    let Ok(config) = Config::load() else {
+        return;
+    };
+    let Some(tee_dir) = get_tee_dir(&config) else {
+        return;
+    };
+    if std::fs::create_dir_all(&tee_dir).is_ok() {
+        let _ = std::fs::write(tee_dir.join("phenix-raw.log"), raw);
+    }
+}
