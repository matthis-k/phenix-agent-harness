{
  jobs,
  outputName ? "phenix-maintenance",
  workflowName ? "CI",
  mainBranch ? "main",
  gateName ? "Maintenance checks",
  checkoutAction ? "actions/checkout@93cb6efe18208431cddfb8368fd83d5badbf9bfd",
  installNixAction ? "cachix/install-nix-action@a49548c11d9846ad46ecc0115273879b045f001c",
  clean ? true,
}:
let
  inherit (builtins)
    attrNames
    concatStringsSep
    map
    match
    replaceStrings
    toJSON
    ;

  fail = message: throw "phenix-flake-maintenance: ${message}";

  validOutputName = match "^[A-Za-z0-9][A-Za-z0-9_-]*$" outputName != null;
  yaml = value: toJSON value;
  commandArgs = command: concatStringsSep " " command.path;

  renderEnv = env:
    let
      names = attrNames env;
    in
    if names == [ ] then
      ""
    else
      ''
        env:
        ${concatStringsSep "\n" (map (name: "  ${name}: ${yaml env.${name}}") names)}
      '';

  renderNeeds = needs:
    if needs == [ ] then
      ""
    else
      ''
        needs:
        ${concatStringsSep "\n" (map (need: "  - ${need}") needs)}
      '';

  indent = prefix: text: prefix + replaceStrings [ "\n" ] [ "\n${prefix}" ] text;

  renderStep = env: command:
    let
      envBlock = renderEnv env;
    in
    ''
      - name: ${yaml command.name}
      ${if envBlock == "" then "" else indent "  " envBlock}
        run: nix run .#${outputName} -- ${commandArgs command}
    '';

  renderCleanStep = ''
      - name: Repository remains clean
        if: ''${{ !cancelled() }}
        run: |
          set -euo pipefail
          git diff --exit-code
          test -z "$(git status --porcelain=v1 --untracked-files=all)"
  '';

  renderJob = job:
    let
      needsBlock = renderNeeds job.needs;
      commandSteps = concatStringsSep "\n" (map (renderStep job.env) job.commands);
    in
    ''
      ${job.id}:
        if: github.event_name != 'pull_request' || github.event.pull_request.draft == false
        name: ${yaml job.name}
        runs-on: ${yaml job.runner}
        timeout-minutes: ${toString job.timeout}
      ${if needsBlock == "" then "" else indent "  " needsBlock}
        steps:
          - uses: ${checkoutAction} # v5

          - uses: ${installNixAction} # v31
            with:
              github_access_token: ''${{ secrets.GITHUB_TOKEN }}
              extra_nix_config: |
                experimental-features = nix-command flakes
                accept-flake-config = true
                max-jobs = auto

      ${indent "    " commandSteps}
      ${if clean then indent "    " renderCleanStep else ""}
    '';

  jobIds = map (job: job.id) jobs;
  gateTests = concatStringsSep "\n" (
    map (id: "          [[ '\${{ needs.${id}.result }}' == success ]]") jobIds
  );
  gateNeeds = concatStringsSep "\n" (map (id: "      - ${id}") jobIds);
in
if !validOutputName then
  fail "GitHub outputName must be a simple flake output identifier"
else if jobs == [ ] then
  fail "cannot render a GitHub workflow without CI jobs"
else
  ''
    # Generated by phenix-flake-maintenance. Edit the Nix maintenance declaration, not this file.
    name: ${workflowName}

    on:
      pull_request:
      push:
        branches:
          - ${mainBranch}
      workflow_dispatch:

    permissions:
      contents: read

    concurrency:
      group: ci-''${{ github.workflow }}-''${{ github.ref }}
      cancel-in-progress: true

    jobs:
    ${concatStringsSep "\n" (map (job: indent "  " (renderJob job)) jobs)}

      checks:
        if: always() && (github.event_name != 'pull_request' || github.event.pull_request.draft == false)
        name: ${yaml gateName}
        needs:
    ${gateNeeds}
        runs-on: ubuntu-latest
        steps:
          - name: Verify all maintenance jobs passed
            run: |
              set -euo pipefail
    ${gateTests}
  ''
